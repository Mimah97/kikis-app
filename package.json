{
  "name": "kikis-app",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check .",
    "stress:test": "pnpm --filter agent stress",
    "version": "changeset version",
    "release": "pnpm run release:build && changeset publish",
    "release:build": "pnpm --filter @kikis-app/nulth-sdk build && pnpm --filter @kikis-app/kikis-app build && pnpm --filter @kikis-app/mcp-server build",
    "verify": "bash scripts/verify.sh",
    "prepare": "[ -n \"${CI:-}\" ] || git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "prettier": "^3.3.3",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@changesets/cli": "^2.31.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
